            "post": {
                "tags": [
                    "Campaigns"
                ],
                "summary": "Create campaign",
                "operationId": "a581913471d6a1a81878c0c8367743e4",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "name",
                                    "platform",
                                    "impressions",
                                    "clicks",
                                    "conversions",
                                    "cost",
                                    "revenue",
                                    "date_start",
                                    "date_end"
                                ],
                                "properties": {
                                    "name": {
                                        "type": "string",
                                        "example": "Q2 Retargeting"
                                    },
                                    "platform": {
                                        "type": "string",
                                        "enum": [
                                            "Facebook",
                                            "Google",
                                            "TikTok"
                                        ]
                                    },
                                    "impressions": {
                                        "type": "integer",
                                        "example": 120000
                                    },
                                    "clicks": {
                                        "type": "integer",
                                        "example": 2800
                                    },
                                    "conversions": {
                                        "type": "integer",
                                        "example": 140
                                    },
                                    "cost": {
                                        "type": "number",
                                        "format": "float",
                                        "example": 18000000
                                    },
                                    "revenue": {
                                        "type": "number",
                                        "format": "float",
                                        "example": 42000000
                                    },
                                    "date_start": {
                                        "type": "string",
                                        "format": "date",
                                        "example": "2026-04-01"
                                    },
                                    "date_end": {
                                        "type": "string",
                                        "format": "date",
                                        "example": "2026-04-30"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Campaign created"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ],
                "servers": [
                    {
                        "url": "http://127.0.0.1:8000",
                        "description": "Local development server"
                    }
                ]
            }
        },
